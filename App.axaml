<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenStopMotionStudio.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OpenStopMotionStudio/GUI/Theme.axaml"/>
    </Application.Styles>

    <Application.Resources>
         <SolidColorBrush x:Key="SystemAltHighColor">#1E1E1E</SolidColorBrush>
    </Application.Resources>
</Application>
