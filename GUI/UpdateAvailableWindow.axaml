<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenStopMotionStudio.GUI.UpdateAvailableWindow"
        Title="Update Available"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Background="#1E1E1E" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock x:Name="TitleText"
                       Text="A new version is available"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="VersionText"
                       Grid.Row="1"
                       Text="Current: 0.0.0 | New: 0.0.0"
                       Foreground="#C8C8C8"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="2"
                    Background="#2A2A2A"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText"
                               Text="No release notes provided."
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="LaterButton" Content="Later"
                        Width="100"
                        Click="LaterButton_Click"/>
                <Button x:Name="UpdateButton"
                        Content="Update"
                        Width="120"
                        Classes="Primary"
                        Click="UpdateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
