<Window x:Class="OpenStopMotionStudio.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Stop Motion Studio"
        Height="750" Width="1100"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Titelleiste -->
            <RowDefinition Height="50"/>
            <!-- Hauptbereich: Kamera + Sidebar -->
            <RowDefinition Height="*"/>
            <!-- Statusleiste -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  TITELLEISTE                                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMid}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="▶ Open Stop Motion Studio"
                           Foreground="{StaticResource AccentColor}"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  MVP v0.1"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  HAUPTBEREICH                                   -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="230"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Live-Kamera-Feed (flexibel) -->
                <ColumnDefinition Width="*"/>
                <!-- Sidebar mit Controls (feste Breite) -->
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- ─── KAMERA-ANSICHT ─── -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="#0D0D1A"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    ClipToBounds="True">

                <!-- Canvas: Live-Feed + Onion Skin Overlay übereinander -->
                <Grid>
                    <!-- Live-Kamera-Bild (unterste Ebene) -->
                    <Image x:Name="LiveFeedImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Advanced Onion Skin: mehrere vorherige Frames -->
                    <Image x:Name="OnionSkinImageLayer3"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Image x:Name="OnionSkinImageLayer2"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Image x:Name="OnionSkinImageLayer1"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Image x:Name="PlaybackImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Platzhaltertext wenn keine Kamera aktiv -->
                    <TextBlock x:Name="NoCameraText"
                               Text="Keine Kamera verbunden.&#10;Kamera in der Sidebar auswählen."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="16" TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Frame-Zähler Overlay oben links -->
                    <Border Background="#AA000000" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="10" Padding="8,4">
                        <TextBlock x:Name="FrameCounterText"
                                   Text="Frame: 0"
                                   Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource BackgroundMid}"
                    CornerRadius="8"
                    Margin="0,10,10,0"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevFrameButton"
                                Grid.Column="0"
                                Content="◀ Vorheriges"
                                Style="{StaticResource StudioButton}"
                                Padding="10,6"
                                FontSize="11"
                                Click="PrevFrame_Click"/>

                        <Button x:Name="PlayPauseButton"
                                Grid.Column="1"
                                Content="▶ Abspielen"
                                Style="{StaticResource StudioButton}"
                                Padding="10,6"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Click="PlayPause_Click"/>

                        <Button x:Name="NextFrameButton"
                                Grid.Column="2"
                                Content="Nächstes ▶"
                                Style="{StaticResource StudioButton}"
                                Padding="10,6"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Click="NextFrame_Click"/>

                        <TextBlock x:Name="PlaybackStatusText"
                                   Grid.Column="3"
                                   Text="Timeline leer"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="PlaybackSpeedLabel"
                                       Text="Playback: 12 fps"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PlaybackFpsTextBox"
                                         Style="{StaticResource StudioTextBox}"
                                         Width="50"
                                         Text="12"
                                         HorizontalContentAlignment="Center"
                                         LostFocus="PlaybackFpsTextBox_LostFocus"
                                         KeyDown="PlaybackFpsTextBox_KeyDown"/>
                                <TextBlock Text="fps (1-120)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TimelineRangeText"
                                   Grid.Column="5"
                                   Text="Start 1 | Ende 250"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="#101427"
                                CornerRadius="6,0,0,6"
                                BorderBrush="#2D2D44"
                                BorderThickness="1,1,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1B2034">
                                    <TextBlock Text="Dope Sheet"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Border>

                                <Border Grid.Row="1" Background="#35202A">
                                    <TextBlock Text="Summary"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Border>

                                <Border Grid.Row="2" Background="#20263C">
                                    <TextBlock Text="Capture"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Border>

                                <Border Grid.Row="3" Background="#171D30">
                                    <TextBlock Text="Motion Ctrl"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Border>

                                <Border Grid.Row="4" Background="#141A2B">
                                    <TextBlock Text="DMX Licht"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="#0F1220"
                                CornerRadius="0,6,6,0"
                                BorderBrush="#2D2D44"
                                BorderThickness="0,1,1,1">
                            <ScrollViewer x:Name="TimelineScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          PanningMode="HorizontalOnly"
                                          PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                                <Canvas x:Name="TimelineCanvas"
                                        Height="164"
                                        Background="#0F1220"/>
                            </ScrollViewer>
                        </Border>

                        <ScrollBar x:Name="TimelineFrameScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Minimum="1"
                                   Maximum="250"
                                   SmallChange="1"
                                   LargeChange="12"
                                   ViewportSize="1"
                                   Orientation="Horizontal"
                                   ValueChanged="TimelineFrameScrollBar_ValueChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── SIDEBAR ─── -->
            <ScrollViewer Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">

                <!-- Kamera-Auswahl -->
                <Border Background="{StaticResource BackgroundMid}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎥 Kamera" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CameraComboBox"
                                  Style="{StaticResource StudioComboBox}"
                                  FontSize="12" Margin="0,0,0,8"
                                  SelectionChanged="CameraComboBox_SelectionChanged"/>
                        <Button Content="▶ Kamera starten"
                                Style="{StaticResource StudioButton}"
                                x:Name="StartCameraButton"
                                Click="StartCameraButton_Click"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="OpenCameraSettingsButton"
                                Content="Webcam-Steuerung"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OpenCameraSettingsButton_Click"
                                IsEnabled="False"/>
                        <TextBlock Text="Histogramm"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>
                        <Border Background="#0D0D1A"
                                BorderBrush="#2D2D44"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                            <Grid>
                                <Image x:Name="HistogramImage"
                                       Height="68"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="HistogramEmptyText"
                                           Text="Kein Live-Bild"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HistogramStatsText"
                                   Text="Schwarz 0.0% | Mittel 0.0% | Weiß 0.0%"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="10"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Capture Button (Haupt-Aktion) -->
                <Border Background="{StaticResource BackgroundMid}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📸 Aufnahme" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <Button x:Name="CaptureButton"
                                Content="⬤  FRAME AUFNEHMEN"
                                Style="{StaticResource StudioButton}"
                                FontSize="15"
                                HorizontalAlignment="Stretch"
                                Height="48"
                                Click="CaptureButton_Click"
                                IsEnabled="False"/>
                        <!-- Tastaturkürzel-Hinweis -->
                        <TextBlock Text="Shortcut: Leertaste"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Onion Skin Controls -->
                <Border Background="{StaticResource BackgroundMid}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🧅 Onion Skin" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <ToggleButton x:Name="OnionSkinToggle"
                                      Content="Onion Skin: AUS"
                                      Style="{StaticResource OnionToggle}"
                                      HorizontalAlignment="Stretch"
                                      Checked="OnionSkinToggle_Checked"
                                      Unchecked="OnionSkinToggle_Unchecked"/>

                        <TextBlock Text="Layer"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <ComboBox x:Name="OnionLayerComboBox"
                                  Style="{StaticResource StudioComboBox}"
                                  SelectionChanged="OnionLayerComboBox_SelectionChanged">
                            <ComboBoxItem Content="1 Layer"/>
                            <ComboBoxItem Content="2 Layer"/>
                            <ComboBoxItem Content="3 Layer"/>
                        </ComboBox>

                        <!-- Alpha Slider -->
                        <TextBlock x:Name="AlphaLabel"
                                   Text="Transparenz: 40%"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <Slider x:Name="AlphaSlider"
                                Minimum="0" Maximum="100" Value="40"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                ValueChanged="AlphaSlider_ValueChanged"
                                Foreground="{StaticResource AccentColor}"/>

                        <!-- Alpha Preset Buttons -->
                        <TextBlock Text="Schnell-Presets:" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="25%" Tag="25" Click="AlphaPreset_Click"
                                    Style="{StaticResource StudioButton}"
                                    FontSize="11" Padding="8,4" Margin="2"/>
                            <Button Content="50%" Tag="50" Click="AlphaPreset_Click"
                                    Style="{StaticResource StudioButton}"
                                    FontSize="11" Padding="8,4" Margin="2"/>
                            <Button Content="75%" Tag="75" Click="AlphaPreset_Click"
                                    Style="{StaticResource StudioButton}"
                                    FontSize="11" Padding="8,4" Margin="2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stream Deck Status -->
                <Border Background="{StaticResource BackgroundMid}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎛 Stream Deck" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StreamDeckStatusText"
                                   Text="● Nicht verbunden"
                                   Foreground="#FF6B6B"
                                   FontSize="12"/>
                        <Button Content="Verbinden"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="ConnectStreamDeck_Click"/>
                    </StackPanel>
                </Border>

                <!-- Projekt-Ordner -->
                <Border Background="{StaticResource BackgroundMid}" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📁 Projekt" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProjectFolderText"
                                   Text="Kein Ordner gewählt"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Capture-Format"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <ComboBox x:Name="CaptureFormatComboBox"
                                  Style="{StaticResource StudioComboBox}"
                                  SelectionChanged="CaptureFormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="JPEG Sequenz"/>
                            <ComboBoxItem Content="TIFF + Proxy"/>
                        </ComboBox>
                        <TextBlock x:Name="WorkflowInfoText"
                                   Text="Direkte JPEG-Sequenz ohne getrennte Proxy-Dateien"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Shot-Name"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <TextBox x:Name="ShotNameTextBox"
                                 Style="{StaticResource StudioTextBox}"
                                 Text="frame"
                                 KeyDown="ShotNameTextBox_KeyDown"/>
                        <TextBlock x:Name="ShotPreviewText"
                                   Text="Nächste Datei: frame_0001.jpg"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="Shot übernehmen"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="ApplyShotName_Click"/>
                        <Button Content="Ordner wählen"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="SelectFolder_Click"/>

                        <Border Height="1"
                                Background="#2D2D44"
                                Margin="0,12,0,10"/>

                        <TextBlock Text="NEF-Import"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                        <TextBlock x:Name="RawSdkStatusText"
                                   Text="Nikon SDK: wird gesucht..."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="10"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="RAW-Quelle"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <TextBlock x:Name="RawSourceFolderText"
                                   Text="Kein RAW-Ordner gewählt"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Startframe"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <TextBox x:Name="RawFrameStartTextBox"
                                 Style="{StaticResource StudioTextBox}"
                                 Text="1001"
                                 HorizontalContentAlignment="Center"
                                 LostFocus="RawFrameStartTextBox_LostFocus"
                                 KeyDown="RawFrameStartTextBox_KeyDown"/>
                        <TextBlock Text="Proxy-Format"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,10,0,4"/>
                        <ComboBox x:Name="RawProxyFormatComboBox"
                                  Style="{StaticResource StudioComboBox}">
                            <ComboBoxItem Content="JPG Proxy"/>
                            <ComboBoxItem Content="PNG Proxy"/>
                        </ComboBox>
                        <TextBlock Text="Import: TIFF-Master in Raw/&lt;Shot&gt;, Proxy in Proxy/&lt;Shot&gt;"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="10"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="NEF-Ordner wählen"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="SelectRawSourceFolder_Click"/>
                        <Button x:Name="ImportNefButton"
                                Content="NEF importieren"
                                Style="{StaticResource StudioButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="ImportNefButton_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  STATUSLEISTE                                   -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMid}" Padding="12,0">
            <TextBlock x:Name="StatusBarText"
                       Text="Bereit. Kamera auswählen und starten."
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
