<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenStopMotionStudio.GUI.MessageBox"
        Title="Message"
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Title" FontWeight="Bold" Margin="10"/>
            <TextBlock Grid.Row="1" x:Name="MessageTextBlock" Text="Message" Margin="10" TextWrapping="Wrap"/>
            <Button Grid.Row="2" x:Name="OkButton" Content="OK" HorizontalAlignment="Center" Margin="10" Click="OkButton_Click"/>
        </Grid>
    </Border>
</Window>
