<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenStopMotionStudio.GUI.ImportProgressDialog"
        Title="Import läuft"
        Width="460"
        Height="190"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True">
    <Border BorderBrush="#454545" BorderThickness="1" Background="#1F1F1F" CornerRadius="8" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       Text="NEF-Import läuft..."
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="ProgressTextBlock"
                       Grid.Row="1"
                       Text="0 / 0"
                       Foreground="#CCCCCC"
                       FontSize="12"
                       Margin="0,0,0,10"/>

            <ProgressBar x:Name="ImportProgressBar"
                         Grid.Row="2"
                         Minimum="0"
                         Maximum="100"
                         Height="16"
                         Value="0"
                         Margin="0,0,0,10"/>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="CurrentFileTextBlock"
                           Grid.Column="0"
                           Text="Vorbereitung..."
                           Foreground="#AAAAAA"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Abbrechen"
                        Classes="OutlineButton"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
